APP_ENV=production
# Public API base (used by the app for links / CORS context). Match your site.
APP_URL=https://saiishaniyogashala.in/api
FRONTEND_URL=https://saiishaniyogashala.in

DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASS=your_database_password

JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# Razorpay — Dashboard → Account & Settings → API Keys (test: rzp_test_…, live: rzp_live_…)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional; default https://api.razorpay.com
# RAZORPAY_API_BASE=https://api.razorpay.com

VIDEO_SIGNING_KEY=CHANGE_ME_LONG_RANDOM_SECRET
STORAGE_PATH=./storage

# Optional: mail() for password reset / notifications
# MAIL_FROM=noreply@saiishaniyogashala.in
# MAIL_FROM_NAME=SAI ISHANI Yogashala
# ADMIN_NOTIFICATION_EMAIL=
