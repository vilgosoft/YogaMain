APP_ENV=development
APP_URL=http://localhost:8000
# Site URL for password-reset links (must be your live React app on production).
FRONTEND_URL=http://localhost:5173
# Optional: PHP mail() sender for forgot-password (Hostinger often works with your domain email).
MAIL_FROM=noreply@yoursite.com
MAIL_FROM_NAME=SAI ISHANI Yogashala

DB_HOST=127.0.0.1
# XAMPP default is 3306; if another app uses 3306, XAMPP often uses 3307 (see mysql\bin\my.ini → port=)
DB_PORT=3306
DB_NAME=yoga_lms
DB_USER=root
DB_PASS=

# If using Docker MySQL from repo root (docker compose up): use DB_USER=yoga DB_PASS=yoga_secret

JWT_SECRET=change_this_to_a_random_64_char_hex_string
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# Classic PG v1 (salt-based): merchant id + salt from PhonePe sandbox
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=1
PHONEPE_BASE_URL=https://api-preprod.phonepe.com/apis/pg-sandbox

# Standard Checkout v2: JWT from PhonePe Business dashboard (Authorization: O-Bearer …).
# If set, v2 is used and salt/merchant above are not required for /pay.
PHONEPE_AUTH_TOKEN=
# Override only if PhonePe changes endpoints (sandbox default below).
# PHONEPE_CHECKOUT_V2_URL=https://api-preprod.phonepe.com/apis/pg-sandbox/checkout/v2/pay

VIDEO_SIGNING_KEY=change_this_to_a_random_64_char_hex_string
STORAGE_PATH=./storage
FFMPEG_PATH=/usr/bin/ffmpeg
