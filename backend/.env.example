APP_ENV=development
APP_URL=http://localhost:8000
# Site URL for password-reset links (must be your live React app on production).
FRONTEND_URL=http://localhost:5173
# Optional: PHP mail() sender for forgot-password (Hostinger often works with your domain email).
MAIL_FROM=noreply@yoursite.com
MAIL_FROM_NAME=SAI ISHANI Yogashala
# Optional: where “I’m interested” on upcoming courses sends mail (defaults to first active admin user).
ADMIN_NOTIFICATION_EMAIL=

DB_HOST=127.0.0.1
# XAMPP default is 3306; if another app uses 3306, XAMPP often uses 3307 (see mysql\bin\my.ini → port=)
DB_PORT=3306
DB_NAME=yoga_lms
DB_USER=root
DB_PASS=

# If using Docker MySQL from repo root (docker compose up): use DB_USER=yoga DB_PASS=yoga_secret

JWT_SECRET=change_this_to_a_random_64_char_hex_string
JWT_ACCESS_TTL=3600
JWT_REFRESH_TTL=2592000

# Razorpay (https://dashboard.razorpay.com → API Keys). Test keys start with rzp_test_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional; default https://api.razorpay.com
# RAZORPAY_API_BASE=https://api.razorpay.com

VIDEO_SIGNING_KEY=change_this_to_a_random_64_char_hex_string
STORAGE_PATH=./storage
FFMPEG_PATH=/usr/bin/ffmpeg
